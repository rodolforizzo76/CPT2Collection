#. Plugin Name of the plugin
#: cpt2collection.php
#: includes/admin/class-meta-box.php:55
#: includes/admin/class-orders-page.php:22
msgid "CPT2Collection"
msgstr "CPT2Collection"

#. Plugin URI of the plugin
#: cpt2collection.php
msgid "https://github.com/rodolforizzo76/CPT2Collection"
msgstr "https://github.com/rodolforizzo76/CPT2Collection"

#. Description of the plugin
#: cpt2collection.php
msgid "Adds collection-management and commercial metadata to one administrator-selected custom post type."
msgstr ""
"Aggiunge funzioni di gestione della collezione e dati commerciali a un tipo di contenuto "
"personalizzato scelto dall’amministratore."

#. Author of the plugin
#: cpt2collection.php
msgid "Rodolfo Rizzo"
msgstr "Rodolfo Rizzo"

#: includes/admin/class-commerce-reset-page.php:18
#: includes/admin/class-commerce-reset-page.php:40
msgid "Full Commerce Reset"
msgstr "Azzeramento completo del commercio"

#: includes/admin/class-commerce-reset-page.php:41
msgid "Operational commerce records will be permanently removed. Commerce will pause until verified completion."
msgstr ""
"I dati operativi del commercio verranno eliminati definitivamente. Le attività di vendita saranno"
" sospese fino alla verifica del completamento."

#: includes/admin/class-commerce-reset-page.php:41
msgid "Products, settings and physical stock are preserved. External payments are not refunded or cancelled."
msgstr ""
"I prodotti, le impostazioni e le giacenze fisiche vengono conservati. I pagamenti esterni non "
"vengono rimborsati né annullati."

#: includes/admin/class-commerce-reset-page.php:41
msgid "Closing this page pauses progression. Keep the recovery URL to check status and continue later."
msgstr ""
"La chiusura di questa pagina mette in pausa l’operazione. Conserva l’URL di ripresa per "
"controllare lo stato e continuare in seguito."

#: includes/admin/class-commerce-reset-page.php:44
#: assets/js/commerce-reset-admin.js:27
msgid "A ready commerce context could not be verified. Look up an existing operation in Advanced details."
msgstr ""
"Non è stato possibile verificare che il commercio sia pronto. Cerca un’operazione esistente in "
"Dettagli avanzati."

#: includes/admin/class-commerce-reset-page.php:47
msgid "Type the exact confirmation"
msgstr "Digita la conferma esatta"

